# LLM Configuration
LLM_PROVIDER=openai  # openai, anthropic, huggingface
LLM_MODEL=gpt-4
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Hugging Face Configuration
HUGGINGFACE_API_KEY=your_huggingface_key
HUGGINGFACE_MODEL_ID=microsoft/codebert-base

# GitHub Configuration
GITHUB_TOKEN=your_github_token
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# Vector Store Configuration
CHROMA_PERSIST_DIR=./data/chroma
VECTOR_STORE_TYPE=chroma  # chroma, pinecone, weaviate

# Database Configuration (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/jorginhoagent
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Analysis Configuration
BANDIT_LEVEL=high  # low, medium, high
INCLUDE_CONTEXT_ANALYSIS=true
INCLUDE_RAG_LOOKUP=true

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0

# Feature Flags
ENABLE_GITHUB_INTEGRATION=false
ENABLE_RAG=true
ENABLE_ASYNC_ANALYSIS=true
